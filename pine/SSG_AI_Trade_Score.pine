//@version=6
indicator("SSG AI Trade Score v1.3", overlay=true)

//====================================================
// SSG AI TRADE SCORE
// Version : 1.3
// Author  : Eugene + ChatGPT
//
// v1.0
// ✓ EMA Engine
// ✓ Trend Score
// ✓ Dashboard
// ✗ RSI
// ✗ Bollinger Bands
// ✗ Alerts
//
// v1.1
// ✓ RSI Engine
// ✓ Momentum Score
// ✓ Total Score
//
// v1.2
// ✓ Bollinger Bands Engine
// ✓ Bollinger Score
// ✓ Updated Momentum & Total Score
//
// v1.3
// ✓ Break Of Structure Engine
// ✓ Swing High / Swing Low Detection
// ✓ BOS Labels
// ✓ Initial Retest Detection Engine (Ticket #004B-A)
// ✓ Retest Confirmation Filter (Ticket #004B-B)
// ✓ Entry Score Engine v1 (Ticket #004B-C)
// ✓ Directional Entry Display (Ticket #004C-A)
//====================================================

//==============================
// INPUTS
//==============================
ema20Length = input.int(20, "EMA 20", minval=1)
ema50Length = input.int(50, "EMA 50", minval=1)
ema100Length = input.int(100, "EMA 100", minval=1)
rsiLength = input.int(14, "RSI Length", minval=1)
bbLength = input.int(20, "BB Length", minval=1)
bbMultiplier = input.float(2.0, "BB Multiplier", minval=0.1, step=0.1)
pivotLeft = input.int(5, "Pivot Left", minval=1)
pivotRight = input.int(5, "Pivot Right", minval=1)
retestTolerance = input.float(0.1, "Retest Tolerance %", minval=0.01, step=0.01)
entryValidityBars = input.int(10, "Entry Setup Validity Bars", minval=1)

//==============================
// EMA ENGINE
//==============================
ema20 = ta.ema(close, ema20Length)
ema50 = ta.ema(close, ema50Length)
ema100 = ta.ema(close, ema100Length)

// Plot EMA's
plot(ema20, title="EMA 20", color=color.green, linewidth=2)
plot(ema50, title="EMA 50", color=color.orange, linewidth=2)
plot(ema100, title="EMA 100", color=color.red, linewidth=2)

//==============================
// TREND SCORE
//==============================
trendScore = 0

if ema20 > ema50
    trendScore += 10

if ema50 > ema100
    trendScore += 10

if close > ema20
    trendScore += 10

if ema20 > ema20[1]
    trendScore += 10

//==============================
// RSI ENGINE
//==============================
rsi = ta.rsi(close, rsiLength)

rsiScore = 0

if rsi < 30
    rsiScore := 0
else if rsi >= 30 and rsi < 40
    rsiScore := 5
else if rsi >= 40 and rsi < 50
    rsiScore := 10
else if rsi >= 50 and rsi < 65
    rsiScore := 15
else if rsi >= 65 and rsi <= 70
    rsiScore := 10
else
    rsiScore := 0

//==============================
// BOLLINGER BANDS ENGINE
//==============================
[basis, upperBand, lowerBand] = ta.bb(close, bbLength, bbMultiplier)

plot(basis, title="BB Basis", color=color.blue, linewidth=1)
plot(upperBand, title="BB Upper", color=color.new(color.blue, 30), linewidth=1)
plot(lowerBand, title="BB Lower", color=color.new(color.blue, 30), linewidth=1)

bollingerScore = 0

prevOutsideUpper = close[1] > upperBand[1]
prevOutsideLower = close[1] < lowerBand[1]
closesBackInside = close >= lowerBand and close <= upperBand
reentryFromUpper = prevOutsideUpper and closesBackInside
reentryFromLower = prevOutsideLower and closesBackInside
closeAboveUpper = close > upperBand
closeBelowLower = close < lowerBand
touchUpper = high >= upperBand and close <= upperBand
touchLower = low <= lowerBand and close >= lowerBand

if reentryFromUpper or reentryFromLower
    bollingerScore := 15
else if closeAboveUpper or closeBelowLower
    bollingerScore := 10
else if touchUpper or touchLower
    bollingerScore := 5
else
    bollingerScore := 0

momentumScore = rsiScore + bollingerScore

//==============================
// BREAK OF STRUCTURE ENGINE
//==============================
swingHigh = ta.pivothigh(high, pivotLeft, pivotRight)
swingLow = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastSwingHigh = na
var float lastSwingLow = na
var bool bullishBroken = false
var bool bearishBroken = false

if not na(swingHigh)
    lastSwingHigh := swingHigh
    bullishBroken := false

if not na(swingLow)
    lastSwingLow := swingLow
    bearishBroken := false

bullishBOS = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh and not bullishBroken
bearishBOS = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow and not bearishBroken

if bullishBOS
    bullishBroken := true
    label.new(bar_index, low, "BOS ↑", color=color.green, style=label.style_label_up, textcolor=color.white, yloc=yloc.belowbar)

if bearishBOS
    bearishBroken := true
    label.new(bar_index, high, "BOS ↓", color=color.red, style=label.style_label_down, textcolor=color.white, yloc=yloc.abovebar)

plotshape(not na(swingHigh), title="Swing High", style=shape.circle, location=location.abovebar, offset=-pivotRight, color=color.red, size=size.tiny)
plotshape(not na(swingLow), title="Swing Low", style=shape.circle, location=location.belowbar, offset=-pivotRight, color=color.green, size=size.tiny)

//==============================
// RETEST DETECTION ENGINE
//==============================
var float bullishBOSLevel = na
var float bearishBOSLevel = na
var int bullishBOSBar = na
var int bearishBOSBar = na
var bool bullishRetestUsed = false
var bool bearishRetestUsed = false

if bullishBOS
    bullishBOSLevel := lastSwingHigh
    bullishBOSBar := bar_index
    bullishRetestUsed := false

if bearishBOS
    bearishBOSLevel := lastSwingLow
    bearishBOSBar := bar_index
    bearishRetestUsed := false

bullishRetestTol = not na(bullishBOSLevel) ? bullishBOSLevel * retestTolerance / 100 : na
bearishRetestTol = not na(bearishBOSLevel) ? bearishBOSLevel * retestTolerance / 100 : na

bullishRetest = not na(bullishBOSLevel) and not bullishRetestUsed and bar_index > bullishBOSBar and math.abs(low - bullishBOSLevel) <= bullishRetestTol and close > bullishBOSLevel
bearishRetest = not na(bearishBOSLevel) and not bearishRetestUsed and bar_index > bearishBOSBar and math.abs(high - bearishBOSLevel) <= bearishRetestTol and close < bearishBOSLevel

if bullishRetest
    bullishRetestUsed := true
    label.new(bar_index, low, "RETEST ↑", color=color.green, style=label.style_label_up, textcolor=color.white, yloc=yloc.belowbar)

if bearishRetest
    bearishRetestUsed := true
    label.new(bar_index, high, "RETEST ↓", color=color.red, style=label.style_label_down, textcolor=color.white, yloc=yloc.abovebar)

//==============================
//==============================
// ENTRY SCORE ENGINE
// Ticket #004C-B — Directional Entry Confirmation
//==============================
var int setupDirection = 0
var int setupBar = na
var bool setupRetestConfirmed = false
var int entryScore = 0

// Nieuwe bullish setup na bullish BOS
if bullishBOS
    setupDirection := 1
    setupBar := bar_index
    setupRetestConfirmed := false

// Nieuwe bearish setup na bearish BOS
if bearishBOS
    setupDirection := -1
    setupBar := bar_index
    setupRetestConfirmed := false

// Setup blijft tijdelijk geldig
setupActive = setupDirection != 0 and not na(setupBar) and bar_index - setupBar < entryValidityBars

// Directionele trendbevestiging
bullishTrendConfirm =
     close > ema20 and
     ema20 > ema50 and
     ema50 > ema100

bearishTrendConfirm =
     close < ema20 and
     ema20 < ema50 and
     ema50 < ema100

// Directionele momentumbevestiging
bullishMomentumConfirm =
     rsi >= 50 and
     momentumScore >= 10

bearishMomentumConfirm =
     rsi < 50 and
     momentumScore >= 10

// Entry score
if setupActive

    if setupDirection == 1

        if bullishRetest
            setupRetestConfirmed := true

        if setupRetestConfirmed and bullishTrendConfirm and bullishMomentumConfirm
            entryScore := 30
        else if setupRetestConfirmed
            entryScore := 20
        else
            entryScore := 10

    else if setupDirection == -1

        if bearishRetest
            setupRetestConfirmed := true

        if setupRetestConfirmed and bearishTrendConfirm and bearishMomentumConfirm
            entryScore := 30
        else if setupRetestConfirmed
            entryScore := 20
        else
            entryScore := 10

else
    entryScore := 0

    if setupDirection != 0 and not na(setupBar) and bar_index - setupBar >= entryValidityBars
        setupDirection := 0
        setupBar := na
        setupRetestConfirmed := false

totalScore = trendScore + momentumScore + entryScore
//==============================
// ENTRY SIGNAL MARKER
// Ticket #004C-B
// Shows one marker when Entry Score
// reaches 30/30 for the first time
//==============================

// Detect first candle where Entry Score reaches 30
entry30Triggered = entryScore == 30 and entryScore[1] != 30

// Determine direction of the confirmed entry
bullishEntrySignal = entry30Triggered and setupDirection == 1
bearishEntrySignal = entry30Triggered and setupDirection == -1

// Plot one ENTRY marker
if bullishEntrySignal
    label.new(
         bar_index,
         low,
         "ENTRY ↑",
         color=color.lime,
         style=label.style_label_up,
         textcolor=color.white,
         yloc=yloc.belowbar)

if bearishEntrySignal
    label.new(
         bar_index,
         high,
         "ENTRY ↓",
         color=color.red,
         style=label.style_label_down,
         textcolor=color.white,
         yloc=yloc.abovebar)

//==============================
// STATUS
//==============================
status = "NEUTRAL"

if trendScore >= 30
    status := "BULLISH"

if trendScore <= 10
    status := "BEARISH"

//==============================
// DIRECTIONAL ENTRY DISPLAY
// Ticket #004C-A
//==============================
string entryDirectionText = "Entry"
color entryDirectionColor = color.yellow

if setupActive and setupDirection == 1
    entryDirectionText := "Entry ↑"
    entryDirectionColor := color.lime
else if setupActive and setupDirection == -1
    entryDirectionText := "Entry ↓"
    entryDirectionColor := color.red

//==============================
// DASHBOARD
//==============================
var table dash = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast

    table.cell(dash,0,0,
     "SSG AI TRADE SCORE",
     bgcolor=color.rgb(25,25,112),
     text_color=color.white)

    table.cell(dash,1,0,
     "v1.3",
     bgcolor=color.rgb(25,25,112),
     text_color=color.white)

    table.cell(dash,0,1,
     "Trend Score",
     bgcolor=color.rgb(45,45,45),
     text_color=color.white)

    table.cell(dash,1,1,
     str.tostring(trendScore)+" / 40",
     bgcolor=color.rgb(45,45,45),
     text_color=color.lime)

    table.cell(dash,0,2,
     "Momentum",
     bgcolor=color.rgb(45,45,45),
     text_color=color.white)

    table.cell(dash,1,2,
     str.tostring(momentumScore)+" / 30",
     bgcolor=color.rgb(45,45,45),
     text_color=color.orange)

    table.cell(dash,0,3,
     "RSI",
     bgcolor=color.rgb(45,45,45),
     text_color=color.white)

    table.cell(dash,1,3,
     str.tostring(rsiScore)+" / 15",
     bgcolor=color.rgb(45,45,45),
     text_color=color.orange)

    table.cell(dash,0,4,
     "Bollinger",
     bgcolor=color.rgb(45,45,45),
     text_color=color.white)

    table.cell(dash,1,4,
     str.tostring(bollingerScore)+" / 15",
     bgcolor=color.rgb(45,45,45),
     text_color=color.orange)

    table.cell(dash,0,5,
     entryDirectionText,
     bgcolor=color.rgb(45,45,45),
     text_color=color.white)

    table.cell(dash,1,5,
     str.tostring(entryScore)+" / 30",
     bgcolor=color.rgb(45,45,45),
     text_color=entryDirectionColor)

    table.cell(dash,0,6,
     "TOTAL",
     bgcolor=color.rgb(45,45,45),
     text_color=color.white)

    table.cell(dash,1,6,
     str.tostring(totalScore)+" / 100",
     bgcolor=color.rgb(45,45,45),
     text_color=color.lime)

    statusColor =
         status == "BULLISH" ? color.green :
         status == "BEARISH" ? color.red :
         color.orange

    table.cell(dash,0,7,
     "STATUS",
     bgcolor=statusColor,
     text_color=color.white)

    table.cell(dash,1,7,
     status,
     bgcolor=statusColor,
     text_color=color.white)
